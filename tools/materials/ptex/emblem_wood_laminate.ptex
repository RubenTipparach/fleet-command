  {
   "name": "shader_3",
   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "grain",
      "longdesc": "grain",
      "name": "grain",
      "shortdesc": "grain",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "pore",
      "longdesc": "pore",
      "name": "pore",
      "shortdesc": "pore",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "board",
      "longdesc": "board",
      "name": "board",
      "shortdesc": "board",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\n// The plies: 40 per tile across u (1.25 mm each, so a 3 mm limb shows two or three), alternating a warm and a dark\n// wood, a hairline of glue between them.\nvec2 ply_$name(vec2 uv) { float x = uv.x * 40.0; return vec2(mod(floor(x), 2.0), min(fract(x), 1.0 - fract(x))); }\nfloat height_$name(vec2 uv) {\n\tvec2 p = ply_$name(uv);\n\treturn 0.5 + 0.1 * ($grain(uv) - 0.5) - 0.12 * smoothstep(0.75, 0.9, $pore(uv)) - 0.08 * (1.0 - smoothstep(0.0, 0.025, p.y));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec2 p = ply_$name(uv);\n\tvec3 warm = vec3(0.56, 0.35, 0.17), dark = vec3(0.47, 0.28, 0.13);\n\tvec3 c = mix(warm, dark, p.x) * (0.85 + 0.3 * $board(uv));\n\tc *= 0.78 + 0.34 * smoothstep(0.25, 0.75, $grain(uv));\n\tc *= 1.0 - 0.35 * smoothstep(0.75, 0.9, $pore(uv));\n\treturn mix(c * 0.7, c, smoothstep(0.0, 0.025, p.y));\n}\nfloat rough_$name(vec2 uv) { return 0.42 + 0.12 * $grain(uv) + 0.2 * smoothstep(0.75, 0.9, $pore(uv)); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "emblem wood laminate",
    "name": "emblem wood laminate",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "emblem wood laminate"
   },
   "type": "shader"
  },
