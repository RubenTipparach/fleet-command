  {
   "name": "shader_3",
   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "grain",
      "longdesc": "grain",
      "name": "grain",
      "shortdesc": "grain",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "ink",
      "longdesc": "ink",
      "name": "ink",
      "shortdesc": "ink",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fade",
      "longdesc": "fade",
      "name": "fade",
      "shortdesc": "fade",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\n// one rose's cell: q in -0.5..0.5; returns (petal, inner line, heart, leaf). An open rose: five broad rounded petals, a\n// second ring of five between them, each petal's edge and a line down its middle printed darker, a seeded heart\nvec4 rose_$name(vec2 q, float spin) {\n\tfloat r = length(q), a = atan(q.y, q.x) + spin;\n\tfloat e1 = 0.21 + 0.045 * abs(cos(2.5 * a)), e2 = 0.14 + 0.03 * abs(cos(2.5 * a + 0.628));\n\tfloat outer = smoothstep(0.010, -0.010, r - e1);\n\tfloat inner = smoothstep(0.010, -0.010, r - e2);\n\tfloat edge = outer * (1.0 - smoothstep(0.004, 0.011, abs(r - e2)));\n\tedge = max(edge, outer * (1.0 - smoothstep(0.004, 0.011, abs(r - e1 + 0.012))));\n\tedge = max(edge, (1.0 - inner) * outer * (1.0 - smoothstep(0.004, 0.012, abs(cos(2.5 * a) * r))) * 0.55);\n\tfloat heart = smoothstep(0.05, 0.04, r) * (0.6 + 0.4 * step(0.5, fract(a * 1.909)));\n\tfloat leaf = 0.0, vein = 0.0;\n\tfor (int i = 0; i < 4; i++) {\n\t\tfloat b = 0.785398 + 1.570796 * float(i) + spin * 0.5;\n\t\tvec2 d = vec2(cos(b), sin(b));\n\t\tvec2 p = q - d * 0.31;\n\t\tvec2 l = vec2(dot(p, d), dot(p, vec2(-d.y, d.x)));\n\t\tfloat m = smoothstep(0.012, -0.012, length(l / vec2(0.10, 0.042)) - 1.0);\n\t\tleaf = max(leaf, m);\n\t\tvein = max(vein, m * (1.0 - smoothstep(0.002, 0.007, abs(l.y))));\n\t}\n\treturn vec4(max(outer, inner * 0.0), max(edge, vein), heart, leaf * (1.0 - outer));\n}\n// the repeat: two columns and two rows of roses to the tile, each column dropped half a row; sprigs (three dots on a\n// short stem) on a lattice of their own, half a cell over, so each sits whole between four roses\nvec4 print_$name(vec2 uv) {\n\tvec2 s = uv * 2.0;\n\tfloat col = floor(s.x);\n\tvec2 sr = s + vec2(0.0, 0.5 * mod(col, 2.0));\n\tvec2 cell = floor(sr), q = fract(sr) - 0.5;\n\tfloat spin = 0.4 * sin(cell.x * 1.7 + cell.y * 2.3);\n\tvec4 rose = rose_$name(q, spin);\n\tvec2 ss = s + vec2(0.5, 0.25);\n\tvec2 sc = fract(ss) - 0.5;\n\tfloat sprig = 0.0;\n\tfor (int i = 0; i < 3; i++) {\n\t\tfloat b = 2.094395 * float(i) + 1.5708;\n\t\tsprig = max(sprig, smoothstep(0.020, 0.011, length(sc - 0.045 * vec2(cos(b), sin(b)))));\n\t}\n\tsprig = max(sprig, (1.0 - smoothstep(0.002, 0.006, abs(sc.x))) * step(-0.12, sc.y) * step(sc.y, -0.03));\n\treturn vec4(rose.x, max(rose.y, rose.z), rose.w, sprig);\n}\nfloat height_$name(vec2 uv) { vec4 p = print_$name(uv); return 0.5 + 0.1 * max(max(p.x, p.z), p.w) + 0.2 * ($grain(uv) - 0.5); }\nvec3 albedo_$name(vec2 uv) {\n\tvec3 paper = vec3(0.94, 0.84, 0.72), petal = vec3(0.93, 0.55, 0.42), deep = vec3(0.80, 0.36, 0.27), leaf = vec3(0.95, 0.68, 0.52);\n\tvec4 p = print_$name(uv);\n\tfloat soft = 0.82 + 0.18 * $ink(uv);\n\tvec3 c = paper * (0.97 + 0.06 * ($grain(uv) - 0.5));\n\tc = mix(c, leaf, p.z * 0.85 * soft);\n\tc = mix(c, petal, p.x * 0.9 * soft);\n\tc = mix(c, deep, p.y * 0.85 * soft);\n\tc = mix(c, deep, p.w * 0.7 * soft);\n\tc = mix(c, c * vec3(0.96, 0.93, 0.88), smoothstep(0.55, 0.85, $fade(uv)) * 0.5);\n\treturn c;\n}\nfloat rough_$name(vec2 uv) { return 0.75; }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "wallpaper floral",
    "name": "wallpaper floral",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "wallpaper floral"
   },
   "type": "shader"
  },
