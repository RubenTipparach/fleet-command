  {
   "name": "shader_4",
   "node_position": {
    "x": 1100,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "blot",
      "longdesc": "blot",
      "name": "blot",
      "shortdesc": "blot",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "run",
      "longdesc": "run",
      "name": "run",
      "shortdesc": "run",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "cloud",
      "longdesc": "cloud",
      "name": "cloud",
      "shortdesc": "cloud",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "speck",
      "longdesc": "speck",
      "name": "speck",
      "shortdesc": "speck",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\n// Where the blood is: blots, runs along the shaft's length, and fine spatter; 0 none, 1 thick.\nfloat blood_$name(vec2 uv) {\n\tfloat b = smoothstep(0.48, 0.62, $blot(uv));\n\tb = max(b, 0.8 * smoothstep(0.6, 0.72, $run(uv)));\n\treturn max(b, 0.7 * smoothstep(0.8, 0.86, $speck(uv)));\n}\nfloat height_$name(vec2 uv) { return 0.5 + 0.1 * blood_$name(uv) + 0.04 * ($blot(uv) - 0.5); }\nvec3 albedo_$name(vec2 uv) {\n\tvec3 green = mix(vec3(0.04, 0.33, 0.15), vec3(0.17, 0.62, 0.32), 0.35 + 0.4 * $cloud(uv));\n\tfloat b = blood_$name(uv);\n\tvec3 thin = vec3(0.45, 0.03, 0.03), thick = vec3(0.16, 0.01, 0.015);\n\tvec3 blood = mix(thin, thick, smoothstep(0.55, 0.85, $blot(uv)));\n\treturn mix(green, blood, b);\n}\nfloat rough_$name(vec2 uv) { return mix(0.18, 0.1, blood_$name(uv) * smoothstep(0.6, 0.8, $blot(uv))) + 0.15 * blood_$name(uv) * (1.0 - smoothstep(0.6, 0.8, $blot(uv))); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "emblem blood watch",
    "name": "emblem blood watch",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "emblem blood watch"
   },
   "type": "shader"
  },
