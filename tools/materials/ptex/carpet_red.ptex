   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "pile",
      "longdesc": "pile",
      "name": "pile",
      "shortdesc": "pile",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "tuft",
      "longdesc": "tuft",
      "name": "tuft",
      "shortdesc": "tuft",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "nap",
      "longdesc": "nap",
      "name": "nap",
      "shortdesc": "nap",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "wear",
      "longdesc": "wear",
      "name": "wear",
      "shortdesc": "wear",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat height_$name(vec2 uv) { return 0.5 + 0.35 * ($pile(uv) - 0.5) + 0.25 * ($tuft(uv) - 0.5); }\nvec3 albedo_$name(vec2 uv) {\n\tvec3 red = vec3(0.42, 0.045, 0.055), deep = vec3(0.22, 0.02, 0.03);\n\tvec3 c = mix(deep, red, 0.55 + 0.8 * ($pile(uv) - 0.5) + 0.5 * ($tuft(uv) - 0.5));\n\tc *= 0.86 + 0.28 * $nap(uv);\n\tc = mix(c, c * vec3(1.18, 1.05, 1.05), 0.4 * smoothstep(0.62, 0.8, $wear(uv)));\n\treturn c;\n}\nfloat rough_$name(vec2 uv) { return 0.97; }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "carpet red",
    "name": "carpet red",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "carpet red"
   },
