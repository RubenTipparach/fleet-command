  {
   "name": "shader_3",
   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "grain",
      "longdesc": "grain",
      "name": "grain",
      "shortdesc": "grain",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "brush",
      "longdesc": "brush",
      "name": "brush",
      "shortdesc": "brush",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "cloud",
      "longdesc": "cloud",
      "name": "cloud",
      "shortdesc": "cloud",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat height_$name(vec2 uv) { return 0.5 + 0.22 * ($brush(uv) - 0.5) + 0.1 * ($grain(uv) - 0.5); }\nvec3 albedo_$name(vec2 uv) {\n\tvec3 deep = vec3(0.04, 0.33, 0.15), bright = vec3(0.17, 0.62, 0.32);\n\tvec3 c = mix(deep, bright, 0.35 + 0.4 * $cloud(uv));\n\treturn c * (0.9 + 0.12 * $grain(uv));\n}\nfloat rough_$name(vec2 uv) { return 0.16 + 0.08 * $brush(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "emblem lacquer watch",
    "name": "emblem lacquer watch",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "emblem lacquer watch"
   },
   "type": "shader"
