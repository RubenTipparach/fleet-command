  {
   "name": "shader_3",
   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "vein",
      "longdesc": "vein",
      "name": "vein",
      "shortdesc": "vein",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "cloud",
      "longdesc": "cloud",
      "name": "cloud",
      "shortdesc": "cloud",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "speck",
      "longdesc": "speck",
      "name": "speck",
      "shortdesc": "speck",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat height_$name(vec2 uv) { return 0.5 + 0.18 * smoothstep(0.6, 0.85, $vein(uv)) + 0.05 * ($cloud(uv) - 0.5); }\nvec3 albedo_$name(vec2 uv) {\n\tvec3 deep = vec3(0.03, 0.2, 0.04), bright = vec3(0.16, 0.5, 0.09), yellow = vec3(0.36, 0.6, 0.12);\n\tvec3 c = mix(deep, bright, 0.3 + 0.6 * $cloud(uv));\n\tc = mix(c, yellow, 0.35 * smoothstep(0.6, 0.85, $vein(uv)));\n\treturn c * (0.92 + 0.12 * $speck(uv));\n}\nfloat rough_$name(vec2 uv) { return 0.42 + 0.12 * $cloud(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "emblem fern",
    "name": "emblem fern",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "emblem fern"
   },
