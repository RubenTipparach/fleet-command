   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "mott",
      "longdesc": "mott",
      "name": "mott",
      "shortdesc": "mott",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "blot",
      "longdesc": "blot",
      "name": "blot",
      "shortdesc": "blot",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fibx",
      "longdesc": "fibx",
      "name": "fibx",
      "shortdesc": "fibx",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fiby",
      "longdesc": "fiby",
      "name": "fiby",
      "shortdesc": "fiby",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "tooth",
      "longdesc": "tooth",
      "name": "tooth",
      "shortdesc": "tooth",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fox",
      "longdesc": "fox",
      "name": "fox",
      "shortdesc": "fox",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat foxing_$name(vec2 uv) { return smoothstep(0.80, 0.86, $fox(uv)); }\nfloat height_$name(vec2 uv) {\n\treturn 0.5 + 0.25 * ($tooth(uv) - 0.5) + 0.12 * ($fibx(uv) + $fiby(uv) - 1.0) + 0.1 * ($mott(uv) - 0.5);\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec3 cream = vec3(0.86, 0.79, 0.64), aged = vec3(0.74, 0.62, 0.43);\n\tfloat age = smoothstep(0.35, 0.85, $mott(uv)) * 0.32 + smoothstep(0.6, 0.9, $blot(uv)) * 0.18;\n\tvec3 c = mix(cream, aged, age);\n\tc *= 0.96 + 0.06 * ($fibx(uv) + $fiby(uv) - 1.0) + 0.05 * ($tooth(uv) - 0.5);\n\tfloat f = foxing_$name(uv);\n\tc = mix(c, vec3(0.55, 0.36, 0.20), 0.55 * f);\n\tc = mix(c, vec3(0.38, 0.22, 0.12), 0.5 * smoothstep(0.87, 0.91, $fox(uv)));\n\treturn c;\n}\nfloat rough_$name(vec2 uv) { return 0.88 + 0.08 * ($tooth(uv) - 0.5); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "map paper",
    "name": "map paper",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "map paper"
   },
