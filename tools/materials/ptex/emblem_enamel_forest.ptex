  {
   "name": "shader_5",
   "node_position": {
    "x": 1320,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "leaf",
      "longdesc": "leaf",
      "name": "leaf",
      "shortdesc": "leaf",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "leaf2",
      "longdesc": "leaf2",
      "name": "leaf2",
      "shortdesc": "leaf2",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "bark",
      "longdesc": "bark",
      "name": "bark",
      "shortdesc": "bark",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "haze",
      "longdesc": "haze",
      "name": "haze",
      "shortdesc": "haze",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "peel",
      "longdesc": "peel",
      "name": "peel",
      "shortdesc": "peel",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\n// Trunks: 5 columns across the tile, each with a trunk at a hashed offset and width, near (dark, wide) or far (pale, thin).\n// Returns x the trunk's cover (0-1), y its depth (0 far, 1 near).\nvec2 trunk_$name(vec2 uv) {\n\tfloat cols = 5.0; float c = floor(uv.x * cols); float f = fract(uv.x * cols);\n\tfloat near = step(0.55, hs_$name(vec2(c, 5.0)));\n\tfloat w = mix(0.1, 0.18, hs_$name(vec2(c, 9.0))) * mix(0.8, 1.8, near);\n\tfloat x0 = mix(0.2, 0.8, hs_$name(vec2(c, 13.0)));\n\tfloat lean = 0.03 * (hs_$name(vec2(c, 21.0)) - 0.5) * sin(6.2831853 * uv.y);\n\tfloat t = 1.0 - smoothstep(w * 0.4, w * 0.5, abs(f - x0 - lean));\n\treturn vec2(t * step(0.15, hs_$name(vec2(c, 31.0))), near);\n}\n// The canopy: dry leaves where the leaf noise is high, thicker toward the top of the tile's repeat, broken by light.\nfloat canopy_$name(vec2 uv) {\n\tfloat l = 0.65 * $leaf(uv) + 0.35 * $leaf2(uv);\n\treturn smoothstep(0.47, 0.57, l);\n}\nfloat height_$name(vec2 uv) {\n\tvec2 t = trunk_$name(uv);\n\treturn 0.5 + 0.12 * ($peel(uv) - 0.5) + 0.12 * t.x * (0.5 + t.y) + 0.08 * canopy_$name(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec3 beige = vec3(0.64, 0.57, 0.43), haze = vec3(0.55, 0.5, 0.38);\n\tvec3 c = mix(beige, haze, $haze(uv));\n\tvec2 t = trunk_$name(uv);\n\tvec3 farT = vec3(0.44, 0.35, 0.24), nearT = vec3(0.26, 0.18, 0.11);\n\tvec3 trunkC = mix(farT, nearT, t.y) * (0.85 + 0.3 * $bark(uv));\n\tc = mix(c, trunkC, t.x);\n\tfloat can = canopy_$name(uv);\n\tvec3 dry = vec3(0.42, 0.44, 0.25), olive = vec3(0.3, 0.33, 0.18), straw = vec3(0.56, 0.53, 0.33);\n\tvec3 leafC = mix(olive, dry, smoothstep(0.3, 0.7, $leaf2(uv)));\n\tleafC = mix(leafC, straw, 0.5 * smoothstep(0.72, 0.85, $leaf2(uv)));\n\treturn mix(c, leafC, can * 0.92);\n}\nfloat rough_$name(vec2 uv) { return 0.3 + 0.1 * $peel(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "emblem enamel forest",
    "name": "emblem enamel forest",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "emblem enamel forest"
   },
   "type": "shader"
  },
