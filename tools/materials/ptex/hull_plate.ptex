  {
   "name": "shader_2",
   "node_position": {
    "x": 660,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "n",
      "longdesc": "n",
      "name": "n",
      "shortdesc": "n",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "streak",
      "longdesc": "streak",
      "name": "streak",
      "shortdesc": "streak",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\n// Per texel: x, y the distance to the nearest seam in metres, z the plate's hash, w the raised access plate mask.\nvec4 plate_$name(vec2 uv) {\n\tfloat rows = 4.0;\n\tfloat r = floor(uv.y * rows);\n\tfloat n = 2.0 + floor(hs_$name(vec2(r, 3.0)) * 3.0);\n\tfloat x = fract(uv.x + hs_$name(vec2(r, 7.0)));\n\tfloat c = floor(x * n);\n\tvec2 f = vec2(fract(x * n), fract(uv.y * rows));\n\tvec2 d = vec2(min(f.x, 1.0 - f.x) * 2.0 / n, min(f.y, 1.0 - f.y) * 2.0 / rows);\n\tfloat id = hs_$name(vec2(c + 17.0 * r, r + 1.0));\n\tfloat inset = step(0.72, id) * smoothstep(0.08, 0.085, d.x) * smoothstep(0.06, 0.065, d.y);\n\treturn vec4(d, id, inset);\n}\nfloat seam_$name(vec4 p) { return smoothstep(0.003, 0.006, min(p.x, p.y)); }\nfloat height_$name(vec2 uv) {\n\tvec4 p = plate_$name(uv);\n\treturn 0.3 + 0.5 * seam_$name(p) + 0.15 * p.w + 0.03 * ($n(uv) - 0.5);\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec4 p = plate_$name(uv);\n\tfloat v = 0.62 + 0.06 * (p.z - 0.5) + 0.03 * ($n(uv) - 0.5);\n\tfloat grime = (1.0 - smoothstep(0.0, 0.03, min(p.x, p.y))) * 0.18 + 0.05 * smoothstep(0.6, 0.9, $streak(uv));\n\tv *= 1.0 - grime;\n\treturn vec3(v * 0.93, v * 0.96, v) * (1.0 - 0.6 * (1.0 - seam_$name(p)));\n}\nfloat rough_$name(vec2 uv) {\n\tvec4 p = plate_$name(uv);\n\treturn 0.42 + 0.12 * (p.z - 0.5) + 0.1 * $n(uv) + 0.25 * (1.0 - seam_$name(p));\n}\nfloat metal_$name(vec2 uv) { return 0.1; }\n",
    "longdesc": "hull plate",
    "name": "hull plate",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "hull plate"
   },
