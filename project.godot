; Fleet Command: the Godot project (CLAUDE.md section 2). Godot 4.7.1 .NET, C#.
; The console is laid out on a 1500 x 1080 base that expands with the window (canvas_items, expand), which is the
; battle-console layout's scale rule: the height sets the scale, and 1500 px of width at most (data/console/layout.json).

config_version=5

[application]

config/name="Fleet Command"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

window/size/viewport_width=1500
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="FleetCommand"

