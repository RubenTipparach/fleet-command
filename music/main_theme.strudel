// @title Fleet Command: Main Title
// @cycles 22
// @reverb 0.5
// @space gm_french_horn 0.3
// @space gm_trumpet 0.3
// @space gm_pad_poly 0.45
// @space gm_fx_sci_fi 0.5
// @space gm_glockenspiel 0.4
// @mix gm_french_horn vol=100
// @mix gm_trumpet vol=165
// @mix gm_contrabass vol=105
// @mix gm_tuba vol=70
// @mix gm_brass_section vol=80
//
// The main title: the Concord theme, first on horns over a synth bed, then in full on
// trumpets and strings, landing on the wonder chord. 96 BPM, 22 bars (55 s): a 4-bar
// opening on the wonder chord (the bed, a harp, the theme's head on a glockenspiel), the
// theme on horns (8 bars), the theme in full (8 bars), the wonder chord held (2 bars).
// Motifs: docs/design/music.md.

setcps(96/60/4)

// ── MOTIF LIBRARY ──────────────────────────────────────────────
// THE CONCORD: the player's fleet. An 8-bar sentence in E flat major (docs/design/music.md,
// "Writing a melody"): a 2-bar idea (a dotted leap of a sixth, the gap filled by step, then a
// fall through the chord), the idea again a fourth up on A flat, the lift to F MAJOR (its A
// natural, the raised fourth of E flat, is the Concord's sense of wonder), two bars that
// shorten the idea and climb, the one high point (B flat 5, bar 7) and a cadence home.
// In eighths: @2 a quarter, @3 a dotted quarter, @4 a half.
const CONCORD = note(`<
  [eb4@3 c5 c5@2 bb4 c5]   [eb5@4 c5@2 g4@2]
  [ab4@3 f5 f5@2 eb5 f5]   [g5@4 f5@2 a4@2]
  [bb4@2 d5@2 bb4 d5 g5@2] [c5@2 eb5@2 c5 eb5 ab5@2]
  [bb5@6 ab5@2]            [g5@3 f5 eb5@4]
>`)
const CONCORD_CHORDS = note(`<
  [eb3,g3,bb3] [c3,eb3,g3] [ab2,c3,eb3] [f3,a3,c4]
  [g3,bb3,d4] [ab3,c4,eb4] [[bb2,eb3,f3] [bb2,d3,f3,ab3]] [eb3,g3,bb3]
>`)
const CONCORD_ROOTS = note("<eb2 c2 ab1 f2 g1 ab1 bb1 eb2>")
// THE WONDER CHORD: E flat with the raised fourth (E flat, B flat, D, G, A): the Concord at rest.
const WONDER = note("[eb2,bb2,g3,d4,a4]")
// THE THREAT: whoever the fleet is fighting (no faction's own theme: survey S2 asks for those).
// A low ostinato in C minor, 16ths grouped 3+3+3+3+4, grinding C against D flat, the fourth
// bar on G with the flat nine...
const THREAT = note(`<
  [c2 c3 c2 c2 c3 c2 c2 c3 c2 db2 db3 db2 c2 g1 ab1 g1]
  [c2 c3 c2 c2 c3 c2 eb2 eb3 eb2 db2 db3 db2 c2 bb1 ab1 g1]
  [c2 c3 c2 c2 c3 c2 c2 c3 c2 db2 db3 db2 c2 g1 ab1 g1]
  [g1 g2 g1 g1 g2 g1 ab1 ab2 ab1 g1 g2 g1 b1 c2 d2 eb2]
>`)
const THREAT_ACCENT = "1 .5 .5 1 .5 .5 1 .5 .5 1 .5 .5 1 .65 .65 .65"
const THREAT_HITS = "x ~ ~ x ~ ~ x ~ ~ x ~ ~ x ~ ~ ~"
const THREAT_CHORDS = note("<[c3,eb3,g3] [c3,db3,f3,ab3] [ab2,c3,eb3] [g2,b2,d3,ab3]>")
// ... and its call on the horns: up a semitone, down a tritone; then the answer that sinks back.
const THREAT_CALL = note("<[c4@2 db4@2 g3@4] [c4@2 eb4 db4 c4@4]>")
// THE LOST: a ship or a battle lost. The Concord's idea in E flat MINOR, slow, on one horn.
const LOST = note(`<
  [eb4@3 cb5 cb5@2 bb4 cb5] [db5@4 bb4@2 gb4@2]
  [f4@4 gb4@2 f4@2]         [eb4@8]
>`)
const LOST_CHORDS = note("<[eb3,gb3,bb3] [cb3,eb3,gb3] [bb2,db3,f3] [eb3,gb3,bb3]>")
// ── THE FACTIONS (owner, 2026-11-07: "we need custom music for each faction (just do the ones in game
// right now)"). Each is built only from its faction's written culture, every choice naming its source in
// docs/design/music.md, never from what the species looks like (CLAUDE.md section 1). Provisional until the
// owner hears it (survey S5-S7).
// THE KRAI WARHOST: "this faction believes strongly in tradition" (owner, 2026-11-04): tradition "is kept,
// carried and added to, never replaced". THE LINE is a ground bass in D Phrygian that never changes; every
// pass adds a voice over it. Phrases are five bars, after the livery's battle tallies in fives.
const KRAI_LINE = note(`<
  [d2@4 f2@2 eb2@2] [c2@4 d2@4] [bb1@4 c2@2 eb2@2] [d2@4 a1@4] [d2@8]
>`)
// The three great houses (owner: "a star ruling over the 3 great houses"), open fifths, unadorned.
const KRAI_HOUSES = note("<[d3,a3] [c3,g3] [bb2,f3] [d3,a3] [d3,a3]>")
// THE CROWN, the emperor over the houses, on trumpets: one high point (A5) in bar 3 of five.
const KRAI_CROWN = note(`<
  [a4@2 d5@2 f5@4] [eb5@3 d5 c5@2 d5@2] [f5@2 g5@2 a5@4] [g5@3 f5 eb5@2 d5@2] [d5@8]
>`)
// THE TALLY: five strikes in the fifth bar of every phrase, counted.
const KRAI_TALLY = "<~ ~ ~ ~ [x x x x x ~ ~ ~]>"
// THE SSARITH HUNT: THE BOWS, after the Bow Rites (owner, 2026-11-04: bows "different sizes to represent
// their different stages", "3 bow and arrows overlapping pointed to the right"): one rising arrow figure in
// B minor pentatonic at three sizes at once, the young bow quick and high, the elder's slow and low.
const BOW_YOUNG = note("[b4 d5 e5 f#5 ~ ~ ~ ~]")
const BOW_GROWN = note("[b3 d4 e4 f#4]/2")
const BOW_ELDER = note("[b2 d3 e3 f#3]/4")
// THE STALK, the Long Watch's patience ("its ships still wait rather than chase"): two bars, mostly rests.
const SSARITH_STALK = note(`<
  [b1 ~ ~ ~ ~ ~ b1 ~ ~ ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ f#1 ~ ~ ~ ~ ~ ~ ~ b1 ~ ~ ~]
>`)
// THE CALL, ending on the open fifth, never home: the Fair Chase's gate left open.
const SSARITH_CALL = note("<[b4@6 a4 f#4] [e4@2 f#4@6]>")
// THE STRIKE: "nothing moves until it strikes": one tutti chord, given once.
const SSARITH_STRIKE = note("[b2,f#3,b3,d4]")
// THE KELVANE INSTITUTE: THE BALMER MOTIF, hydrogen's first four visible spectral lines (656.3, 486.1,
// 434.0, 410.2 nm: frequency ratios 1, 1.350, 1.512, 1.600) rounded to the nearest semitones above C:
// C, F, G, A flat. The Institute's founding measurement (its emblem, the hydrogen atom, owner 2026-11-06).
const BALMER = note("[c5 f5 g5 ab5]")
// THE CALIBRATION: each line brought up to its true note from a semitone below, the needle to the mark.
const CALIBRATE = note("<[b4 c5@3 e5 f5@3] [f#5 g5@3 g5 ab5@3]>")
// THE BASELINE, the Long Baseline's measured steps: a bass falling one equal step a bar.
const BASELINE = note("<c2 bb1 ab1 g1>")
// ── END MOTIF LIBRARY ──────────────────────────────────────────

// the synth bed under everything (survey S1): a pad and a slow swell
const bed = (chords) => stack(chords.s("gm_pad_poly").gain(0.25), chords.s("gm_fx_sci_fi").gain(0.12))
// the harp spread up a chord in eighths
const harp = (chords) => chords.arp("0 1 2 1 0 1 2 1").s("gm_orchestral_harp").gain(0.4)

const opening = stack(
  bed(WONDER),
  note("[eb3 bb3 d4 g4 a4 d5 g5 a5]").s("gm_orchestral_harp").gain(0.45),
  note("<~ ~ [eb6@3 c7 c7@2 bb6 c7] [eb7@4 c7@2 g6@2]>").s("gm_glockenspiel").gain(0.5),
  note("<eb2 ~ ~ ~>").s("gm_timpani").gain(0.6),
  note("<~ ~ ~ eb4>").s("gm_reverse_cymbal").gain(0.5)
)

const horns = stack(
  CONCORD.s("gm_french_horn").gain(1.05),
  CONCORD_CHORDS.s("gm_string_ensemble_1").gain(0.5),
  harp(CONCORD_CHORDS),
  CONCORD_ROOTS.s("gm_contrabass").gain(0.6),
  bed(CONCORD_CHORDS),
  note("<eb2 ~ ~ ~ g1 ~ bb1 ~>").s("gm_timpani").gain(0.55)
)

const full = stack(
  CONCORD.s("gm_trumpet").gain(1.1),
  CONCORD.s("gm_string_ensemble_1").gain(0.6),
  CONCORD.add(note(12)).s("gm_string_ensemble_2").gain(0.4),
  CONCORD_CHORDS.s("gm_brass_section").gain(0.5),
  CONCORD_CHORDS.s("gm_french_horn").gain(0.4),
  CONCORD_ROOTS.s("gm_tuba").gain(0.5),
  CONCORD_ROOTS.s("gm_contrabass").gain(0.6),
  bed(CONCORD_CHORDS),
  CONCORD_ROOTS.add(note(12)).struct("x ~ ~ x ~ ~ x x").s("gm_timpani").gain(0.6),
  s("<cr ~ ~ ~ cr ~ cr ~>").gain(0.7)
)

const close = stack(
  WONDER.s("gm_brass_section").gain(0.55),
  WONDER.s("gm_string_ensemble_1").gain(0.55),
  WONDER.add(note(12)).s("gm_choir_aahs").gain(0.4),
  bed(WONDER),
  note("[eb3 bb3 d4 g4 a4 d5 g5 a5]").s("gm_orchestral_harp").gain(0.4),
  note("<[eb2 eb2 eb2 eb2 eb2 eb2 eb2 eb2] eb2>").s("gm_timpani").gain("<[.3 .35 .4 .45 .5 .55 .6 .7] .8>"),
  s("<~ cr>").gain(0.8)
)

arrange([4, opening], [8, horns], [8, full], [2, close])
