{
 "_doc": "Written by tools/mockups/ship_schematics.py from the ship glbs; do not edit, re-run it. Each ship has two layers, pure white RGB with the drawing in alpha: hull (filled, top-lit, low alpha) and wire (quad edges seen from above plus the outline, full alpha; the edges the hull hides at 0.4). Tint the hull with a dark skin colour, the wire with a bright one, and lay the wire over the hull. A glb point (x, y, z) in metres falls at pixel (origin_px[0] + x / m_per_px, origin_px[1] + z / m_per_px); y (height) is not drawn. A schematic is stale when its source glb's sha256 differs.",
 "conventions": {
  "view": "orthographic, looking straight down -Y (from above)",
  "image_x": "+X (starboard to the right)",
  "image_y": "+Z (the bow, -Z, at the top)",
  "glb_axes": {
   "bow": "-Z",
   "up": "+Y",
   "port": "-X"
  },
  "pixel_origin": "top-left corner of the image; pixel centres at +0.5",
  "centre": "the centre of the hull's top-down bounding box is the centre of the canvas",
  "margin": 0.06,
  "layers": "white RGB, alpha carries the drawing; hull alpha 0.10-0.38, wire alpha up to 1"
 },
