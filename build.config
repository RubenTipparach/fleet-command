# Build configuration: the one place the toolchain versions are written (CLAUDE.md section 6.4).
# Sourced by scripts/install-godot.sh. Shell syntax, KEY=value only, no logic.

# Godot, matched to the owner's other Godot repository (the-federation, build.config).
GODOT_VERSION="4.7.1"
GODOT_RELEASE="stable"
# "mono" is the .NET build: the game is written in C# (owner, 2026-11-03: "we have chosen Godot 4.7 with c#").
# The .NET build cannot export to the web; the targets are Windows desktop and native Android (survey T1).
GODOT_FLAVOR="mono"

# The .NET SDK the C# project builds with (Godot 4.7's projects target net8.0). Installed by
# scripts/install-dotnet.sh into TOOLS_DIR/dotnet.
DOTNET_CHANNEL="8.0"

# Where scripts/install-godot.sh puts the editor. Git ignored.
TOOLS_DIR=".tools"

# Krita, for scripted brushwork (the krita-brushwork skill). Sourced by scripts/install-krita.sh. 5.3 is the last
# Qt5 series, whose Python API (Node.paintLine with pressure, paintPath, paintEllipse) the skill was proven on.
KRITA_VERSION="5.3.4.1"
