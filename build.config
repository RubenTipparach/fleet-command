# Build configuration: the one place the toolchain versions are written (CLAUDE.md section 6.4).
# Sourced by scripts/install-godot.sh. Shell syntax, KEY=value only, no logic.

# Godot, matched to the owner's other Godot repository (the-federation, build.config).
GODOT_VERSION="4.7.1"
GODOT_RELEASE="stable"
# "standard" is GDScript only. The .NET build cannot export to the web, and a browser build for
# phones is a candidate target (survey T1).
GODOT_FLAVOR="standard"

# Where scripts/install-godot.sh puts the editor. Git ignored.
TOOLS_DIR=".tools"
